# Credenciales IMAP
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=tu@email.com
IMAP_PASSWORD=tu_app_password_aqui

# Carpetas IMAP → género, separadas por espacios (entre comillas si tienen espacios)
# Formato: "Ruta/IMAP:Género"
# Ejemplo con varias carpetas:
IMAP_FOLDERS="Bandcamp/Rock:Rock Bandcamp/Electronic:Electronic Bandcamp/Jazz:Jazz"

# Configuración del generador
ITEMS_PER_PAGE=10

# Token para el botón de actualización manual (cámbialo)
UPDATE_TOKEN=pon_aqui_un_token_secreto

# Puerto del servidor
PORT=8765
