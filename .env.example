# Credenciales IMAP
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=tu@email.com
IMAP_PASSWORD=tu_app_password_aqui

# Carpetas IMAP → género, separadas por espacios (entre comillas si tienen espacios)
# Formato: "Ruta/IMAP:Género"
# Ejemplo con varias carpetas:
IMAP_FOLDERS="Bandcamp/Rock:Rock Bandcamp/Electronic:Electronic Bandcamp/Jazz:Jazz"

# Configuración del generador
ITEMS_PER_PAGE=10

# Token para el botón de actualización manual (cámbialo)
UPDATE_TOKEN=pon_aqui_un_token_secreto

# Puerto del servidor
PORT=8765

# ── docker-compose.yml ──────────────────────────────────────────
# Para publicar docs/ en GitHub Pages: tu repo (usuario/repo) y un token con permiso de escritura
PUBLISH_REPO=
GH_PAT=
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
